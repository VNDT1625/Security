# Local development defaults. Never reuse these secrets in production.
LOCAL_TESTING_UNLIMITED=true
APP_ENV=development
DATABASE_URL=sqlite:///./.aisec-data/armor.db
DATABASE_AUTO_CREATE=true
SEED_DEMO_USER=true
API_KEY_PEPPER=dev-api-key-pepper-change-in-production
API_KEY=dev-key-change-in-production
MCP_ALLOW_ANONYMOUS=false
MCP_API_KEY_RATE_LIMIT_PER_MIN=120
MCP_ANONYMOUS_RATE_LIMIT_PER_MIN=10
# Explanation AI provider: adapter (trained project adapters), local (your
# Ollama/LM Studio/vLLM server), endpoint (external OpenAI-compatible API), or
# auto (legacy behavior: endpoint when LLM_BASE_URL is set, otherwise local).
LLM_PROVIDER=auto
# External OpenAI-compatible endpoint. In endpoint mode the application sends
# only its fixed security harness plus allow-listed assessment/evidence context;
# it does not send raw user content, URLs, user questions, or operator context.
# The provider's own retention policy still applies, so choose a provider that
# contractually disables retention if that guarantee is required.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=prewise-security-v1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=500
# Optional contextual specialists. Missing/disabled adapters degrade safely.
ADAPTER_REGISTRY_ENABLED=true
ADAPTER_MANIFEST_PATH=server/adapters/manifest.json
ADAPTER_BASE_URL=
ADAPTER_API_KEY=
ADAPTER_TIMEOUT_SECONDS=15
ADAPTER_MAX_RISK_CONTRIBUTION=0.25
PHONE_INTELLIGENCE_URL=

# Optional local legal/policy RAG. The SQLite index is read-only at runtime.
# Extract the prepared corpus so this file exists, or set an absolute path.
PREWISE_LEGAL_RAG_DB=data/legal_rag/rag.sqlite3
# Development may inspect a legacy DB without a manifest. Production must use true.
PREWISE_LEGAL_RAG_REQUIRE_MANIFEST=false
PREWISE_LEGAL_RAG_CANDIDATE_K=50
# Optional quality profile: immutable dense artifact directory built offline.
PREWISE_LEGAL_RAG_DENSE_DIR=
# Character n-grams improve some accentless/OCR canaries but build an in-memory
# index on first use, increasing cold-start time and RAM. Keep disabled by default.
PREWISE_LEGAL_RAG_ENABLE_CHAR_NGRAMS=false
# Optional in development. Configure the overlay, key file, and key ID together
# only after human review/import has produced a verified overlay for this corpus.
PREWISE_LEGAL_RAG_VERIFICATION_OVERLAY=
PREWISE_LEGAL_RAG_VERIFICATION_KEY_FILE=
PREWISE_LEGAL_RAG_VERIFICATION_KEY_ID=
PREWISE_LEGAL_RAG_REQUIRE_VERIFICATION_OVERLAY=false

# URL intelligence used by Balanced/Deep scans. All remote threat sources are opt-in.
IP_GEOLOCATION_ENABLED=true
IP2LOCATION_API_KEY=
IP_GEOLOCATION_TIMEOUT_SECONDS=3
HUDSON_ROCK_API_KEY=
PHISHTANK_ENABLED=false
PHISHTANK_API_KEY=
IPQS_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
APIVOID_API_KEY=
PHISHDESTROY_ENABLED=false
URLVET_ENABLED=false
URLVET_API_URL=http://127.0.0.1:8080
URLVET_TIMEOUT_SECONDS=12
MISP_ENABLED=false
MISP_BASE_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true

# Quick EXE Lab analysis. Leave the key empty for local PE analysis only.
# A sample is uploaded only after the user explicitly enables sharing.
METADEFENDER_API_KEY=
METADEFENDER_BASE_URL=https://api.metadefender.com/v4
METADEFENDER_TIMEOUT_SECONDS=20

# Optional bounded local feeds and multi-machine IOC consensus.
THREAT_FEED_SCHEDULER_ENABLED=false
THREAT_FEED_SCHEDULER_INTERVAL_MINUTES=60
THREAT_FEED_PHISHTANK_ENABLED=false
THREAT_FEED_PHISHTANK_APP_KEY=
THREAT_FEED_OPENPHISH_ENABLED=false
THREAT_FEED_URLHAUS_ENABLED=false
THREAT_FEED_URLHAUS_AUTH_KEY=
THREAT_FEED_PHISHING_DATABASE_PATH=.aisec-data/Phishing.Database
TELEMETRY_SENSOR_PEPPER=dev-telemetry-pepper-change-in-production
TELEMETRY_RETENTION_DAYS=30
TELEMETRY_CONSENSUS_WINDOW_DAYS=14
TELEMETRY_MIN_INDEPENDENT_SENSORS=2
# Local OpenAI-compatible/Ollama server; no API key is forwarded to it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# 9Router example. 9Router may relay to cloud providers even though its API is
# on localhost, therefore use endpoint mode to retain the no-user-content
# contract. Copy the API key from its dashboard and choose any exact model ID
# or combo name shown by GET http://127.0.0.1:20128/v1/models.
# LLM_PROVIDER=endpoint
# LLM_BASE_URL=http://127.0.0.1:20128/v1
# LLM_API_KEY=<9router-dashboard-api-key>
# LLM_MODEL=kr/claude-sonnet-4.5
IP2WHOIS_API_KEY=
WHOISXML_API_KEY=
IPQS_PHONE_API_KEY=
CORS_ALLOW_ORIGINS=["https://prewise.site","https://www.prewise.site","http://localhost:3000","http://127.0.0.1:3000"]

# SePay webhook + dynamic VietQR image. Account details are used only to generate the public QR.
# Prefer HMAC secret received from SePay; do not commit or expose it.
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=100876855977
SEPAY_BANK_NAME=VietinBank
SEPAY_ACCOUNT_NAME=
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_PAYMENT_EXPIRY_MINUTES=30
SANDBOX_CREDIT_PRICE_VND=5000
SANDBOX_SESSION_MINUTES=10

# AWS disposable Windows sandbox. Prefer an account dedicated to untrusted workloads.
AWS_REGION=ap-southeast-1
AWS_SANDBOX_AMI_ID=
AWS_SANDBOX_INSTANCE_TYPE=m7i-flex.large
AWS_SANDBOX_MAX_AMI_ID=
AWS_SANDBOX_MAX_INSTANCE_TYPE=g4dn.xlarge
# Private subnet must have effective 0.0.0.0/0 -> NAT/proxy egress. An IGW-only
# public subnet cannot provide IPv4 Internet access because workers get no public IP.
AWS_SANDBOX_SUBNET_ID=
AWS_SANDBOX_ASSOCIATE_PUBLIC_IP=false
# Auto detonation security group: private/NAT egress only, no inbound rules.
AWS_SANDBOX_SECURITY_GROUP_ID=
AWS_SANDBOX_KEY_NAME=
AWS_SANDBOX_REMOTE_PORT=8443
# Interactive workers use a dedicated DCV/Guacamole-ready AMI and a private
# gateway-only security group. MAX may use a separate GPU image.
AWS_SANDBOX_INTERACTIVE_AMI_ID=
AWS_SANDBOX_INTERACTIVE_MAX_AMI_ID=
AWS_SANDBOX_INTERACTIVE_INSTANCE_TYPE=m7i-flex.large
AWS_SANDBOX_INTERACTIVE_MAX_INSTANCE_TYPE=g4dn.xlarge
AWS_SANDBOX_INTERACTIVE_SECURITY_GROUP_ID=
# Choose one remote target source. The broker template supports {session_id}
# and {instance_id}; the EC2 tag alternative is read only after instance health.
SANDBOX_REMOTE_BROKER_URL_TEMPLATE=
AWS_SANDBOX_REMOTE_URL_TAG=
SANDBOX_REMOTE_BROKER_SECRET=
# Credential-free JSON health endpoint implemented by the Prewise broker
# adapter. The release preflight validates readiness and required capabilities.
SANDBOX_REMOTE_BROKER_HEALTH_URL=
SANDBOX_REMOTE_ACCESS_TOKEN_TTL_SECONDS=60
SANDBOX_AGENT_REPORT_GRACE_SECONDS=15
SANDBOX_CLOUD_PROVISION_TIMEOUT_MINUTES=10
# HTTPS gateway reachable from the disposable VM; the agent sends its
# short-lived session credential only to this endpoint. *.trycloudflare.com is
# acceptable only for a supervised local demo, never production.
SANDBOX_PUBLIC_BASE_URL=
SANDBOX_SAMPLE_STORAGE_PATH=.aisec-data/cloud-sandbox-samples
PRO_SANDBOX_SESSION_MINUTES=15
MAX_SANDBOX_SESSION_MINUTES=30

# Production must set these values or the services will fail fast:
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://...
# DATABASE_AUTO_CREATE=false
# SEED_DEMO_USER=false
# API_KEY_PEPPER=<at-least-32-random-bytes>
# API_KEY=<random-secret>
# MCP_ALLOW_ANONYMOUS=false
# MCP_API_KEY_RATE_LIMIT_PER_MIN=120
# Anonymous/free server-side quotas
ANONYMOUS_DAILY_SCAN_LIMIT=1000
ANONYMOUS_DAILY_AI_CREDIT_LIMIT=5
ANONYMOUS_DAILY_DEEP_SCAN_LIMIT=100
# Email attachment security (ClamAV should be on a private network only).
CLAMAV_HOST=
CLAMAV_PORT=3310
ATTACHMENT_SCAN_TIMEOUT_SECONDS=10
TESSERACT_EXECUTABLE=
TESSERACT_LANGUAGES=vie+eng
ATTACHMENT_OCR_TIMEOUT_SECONDS=12
EMAIL_ATTACHMENT_SANDBOX_ENABLED=false
EMAIL_ATTACHMENT_ACTIVE_SCAN_LIMIT=12
EMAIL_OCR_IMAGE_LIMIT=5
EMAIL_SANDBOX_FILE_LIMIT=1
EMAIL_ATTACHMENT_BUDGET_SECONDS=35
EMAIL_ANALYSIS_TIMEOUT_SECONDS=90
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://localhost:8000/v1/integrations/gmail/callback
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GMAIL_TOKEN_ENCRYPTION_KEYS=
GMAIL_WEB_RETURN_URL=http://localhost:3000/analyze?gmail=connected
GMAIL_API_TIMEOUT_SECONDS=12
# Optional release notification email (Cloudflare Email Sending REST API)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PREWISE_EMAIL_FROM=
RELEASE_UNSUBSCRIBE_BASE_URL=https://api.prewise.site/v1/waitlist/unsubscribe
PASSWORD_RESET_WEB_URL=https://www.prewise.site/auth
# Enable only when a trusted local web origin must call a localhost backend.
CORS_ALLOW_PRIVATE_NETWORK=false
