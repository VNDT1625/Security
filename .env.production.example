# Sao chép thành .env.production và thay toàn bộ giá trị CHANGE_ME.
# Không commit file chứa secret.
POSTGRES_DB=armor
POSTGRES_USER=armor
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_32_CHARS
APP_ENV=production
LLM_BASE_URL=https://your-private-gpu-endpoint.example/v1
LLM_API_KEY=replace-with-a-long-random-secret
LLM_MODEL=prewise-security-v1
LLM_TIMEOUT_SECONDS=90
LLM_MAX_TOKENS=500
ADAPTER_REGISTRY_ENABLED=true
ADAPTER_MANIFEST_PATH=server/adapters/manifest.json
ADAPTER_BASE_URL=https://your-private-gpu-endpoint.example/v1
ADAPTER_API_KEY=replace-with-a-long-random-secret
ADAPTER_TIMEOUT_SECONDS=15
ADAPTER_MAX_RISK_CONTRIBUTION=0.25
PHONE_INTELLIGENCE_URL=
# Pin an immutable, validated side-by-side Legal RAG release in production.
PREWISE_LEGAL_RAG_DB=/app/data/legal_rag/releases/CHANGE_ME_RELEASE_ID/rag.sqlite3
PREWISE_LEGAL_RAG_REQUIRE_MANIFEST=true
PREWISE_LEGAL_RAG_CANDIDATE_K=50
# Optional local dense index directory belonging to the same corpus release.
PREWISE_LEGAL_RAG_DENSE_DIR=
# Enabling this builds an in-memory character index at first use. Keep false
# unless a frozen benchmark justifies the extra cold-start latency and RAM.
PREWISE_LEGAL_RAG_ENABLE_CHAR_NGRAMS=false
# Prepare and validate the reviewed overlay before deploying this fail-closed setting.
# The HMAC key must be mounted read-only from secret storage, never baked into the image.
PREWISE_LEGAL_RAG_VERIFICATION_OVERLAY=/app/data/legal_rag/releases/CHANGE_ME_RELEASE_ID/verification-overlay.json
PREWISE_LEGAL_RAG_VERIFICATION_KEY_FILE=/run/secrets/legal-rag-verification.hmac
PREWISE_LEGAL_RAG_VERIFICATION_KEY_ID=CHANGE_ME_VERIFICATION_KEY_ID
PREWISE_LEGAL_RAG_REQUIRE_VERIFICATION_OVERLAY=true
IP_GEOLOCATION_ENABLED=true
IP2LOCATION_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
IP2WHOIS_API_KEY=
WHOISXML_API_KEY=
IPQS_PHONE_API_KEY=
PHISHTANK_ENABLED=false
PHISHTANK_API_KEY=
URLVET_ENABLED=false
URLVET_API_URL=http://127.0.0.1:8080
MISP_ENABLED=false
MISP_BASE_URL=
MISP_API_KEY=
MISP_VERIFY_TLS=true
# Optional MetaDefender Cloud for quick EXE hash lookup and consented upload.
METADEFENDER_API_KEY=
METADEFENDER_BASE_URL=https://api.metadefender.com/v4
METADEFENDER_TIMEOUT_SECONDS=20
THREAT_FEED_SCHEDULER_ENABLED=false
THREAT_FEED_PHISHTANK_ENABLED=false
THREAT_FEED_OPENPHISH_ENABLED=false
THREAT_FEED_URLHAUS_ENABLED=false
THREAT_FEED_PHISHING_DATABASE_PATH=.aisec-data/Phishing.Database
TELEMETRY_SENSOR_PEPPER=replace-with-at-least-32-random-characters
TELEMETRY_MIN_INDEPENDENT_SENSORS=2
DATABASE_AUTO_CREATE=false
DATABASE_REQUIRE_TLS=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
SEED_DEMO_USER=false
API_KEY_PEPPER=CHANGE_ME_RANDOM_AT_LEAST_32_BYTES
API_KEY=CHANGE_ME_RANDOM_SERVICE_KEY
MCP_ALLOW_ANONYMOUS=false
# Include "null" so the packaged Electron renderer can call the shared Core API.
CORS_ALLOW_ORIGINS=["https://prewise.site","https://www.prewise.site","null"]
BACKEND_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=https://api.prewise.site
NEXT_PUBLIC_WS_BASE_URL=wss://api.prewise.site

# SePay QR checkout. Use HMAC-SHA256 in SePay; never commit the secret.
SEPAY_WEBHOOK_SECRET=CHANGE_ME_SEPAY_HMAC_SECRET
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_QR_BASE_URL=https://vietqr.app/img
SEPAY_PAYMENT_EXPIRY_MINUTES=30
SANDBOX_CREDIT_PRICE_VND=5000

# Máy Windows dùng một lần cho Sandbox PRO/MAX. Nên dùng AWS account riêng
# cho workload không tin cậy và IAM role thay cho access key tĩnh khi có thể.
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_SANDBOX_AMI_ID=
AWS_SANDBOX_INSTANCE_TYPE=m7i-flex.large
AWS_SANDBOX_MAX_AMI_ID=
AWS_SANDBOX_MAX_INSTANCE_TYPE=g4dn.xlarge
# Private subnet with effective 0.0.0.0/0 -> public NAT Gateway or controlled
# outbound proxy. Keep workers without a public IPv4 address and without inbound.
AWS_SANDBOX_SUBNET_ID=
AWS_SANDBOX_ASSOCIATE_PUBLIC_IP=false
# Auto detonation security group: private/NAT egress only, no inbound rules.
AWS_SANDBOX_SECURITY_GROUP_ID=
AWS_SANDBOX_KEY_NAME=
AWS_SANDBOX_REMOTE_PORT=8443
AWS_SANDBOX_INTERACTIVE_AMI_ID=
AWS_SANDBOX_INTERACTIVE_MAX_AMI_ID=
AWS_SANDBOX_INTERACTIVE_INSTANCE_TYPE=m7i-flex.large
AWS_SANDBOX_INTERACTIVE_MAX_INSTANCE_TYPE=g4dn.xlarge
# Gateway-only inbound; never expose RDP/3389 or the VM directly to the Internet.
AWS_SANDBOX_INTERACTIVE_SECURITY_GROUP_ID=
# Use a private HTTPS broker route template (supports {session_id}/{instance_id})
# or an explicit provider-written EC2 tag. Do not place RDP credentials here.
SANDBOX_REMOTE_BROKER_URL_TEMPLATE=
AWS_SANDBOX_REMOTE_URL_TAG=
# Generate at least 32 random bytes. Broker calls consume with this server secret.
SANDBOX_REMOTE_BROKER_SECRET=
# Stable credential-free HTTPS endpoint of the Prewise broker adapter. A
# temporary *.trycloudflare.com URL is rejected by the production gate.
SANDBOX_REMOTE_BROKER_HEALTH_URL=
SANDBOX_REMOTE_ACCESS_TOKEN_TTL_SECONDS=60
SANDBOX_AGENT_REPORT_GRACE_SECONDS=15
SANDBOX_CLOUD_PROVISION_TIMEOUT_MINUTES=10
# Stable managed HTTPS hostname reachable from the private subnet. Do not use a
# temporary *.trycloudflare.com Quick Tunnel in production.
SANDBOX_PUBLIC_BASE_URL=https://api.prewise.site
# docker-compose.production.yml overrides this with a private, noexec tmpfs.
SANDBOX_SAMPLE_STORAGE_PATH=/app/.aisec-data/cloud-sandbox-samples
PRO_SANDBOX_SESSION_MINUTES=15
MAX_SANDBOX_SESSION_MINUTES=30

# Khi dùng managed PostgreSQL, đặt DATABASE_REQUIRE_TLS=true và URL có:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/armor?sslmode=verify-full
# Anonymous/free server-side quotas
ANONYMOUS_DAILY_SCAN_LIMIT=1000
ANONYMOUS_DAILY_AI_CREDIT_LIMIT=5
ANONYMOUS_DAILY_DEEP_SCAN_LIMIT=100
# Email attachment security. docker-compose.production.yml supplies CLAMAV_HOST.
ATTACHMENT_SCAN_TIMEOUT_SECONDS=10
TESSERACT_LANGUAGES=vie+eng
ATTACHMENT_OCR_TIMEOUT_SECONDS=12
EMAIL_ATTACHMENT_SANDBOX_ENABLED=false
EMAIL_ATTACHMENT_ACTIVE_SCAN_LIMIT=12
EMAIL_OCR_IMAGE_LIMIT=5
EMAIL_SANDBOX_FILE_LIMIT=1
EMAIL_ATTACHMENT_BUDGET_SECONDS=35
EMAIL_ANALYSIS_TIMEOUT_SECONDS=90
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=https://api.prewise.site/v1/integrations/gmail/callback
GMAIL_TOKEN_ENCRYPTION_KEYS=
GMAIL_WEB_RETURN_URL=https://prewise.site/analyze?gmail=connected
GMAIL_API_TIMEOUT_SECONDS=12
# Transactional release notifications via Cloudflare Email Sending
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
PREWISE_EMAIL_FROM=
RELEASE_UNSUBSCRIBE_BASE_URL=https://api.prewise.site/v1/waitlist/unsubscribe
PASSWORD_RESET_WEB_URL=https://www.prewise.site/auth
RELEASE_EMAIL_TIMEOUT_SECONDS=10
RELEASE_EMAIL_MAX_ATTEMPTS=3
CORS_ALLOW_PRIVATE_NETWORK=false
